bin/
obj/
.vs/
.vscode/
*.user
*.suo

# Sauvegardes de dossiers de personnages
Backups/

# Données de jeu copiées pour le développement : ne pas versionner un USER complet.
# Les échantillons nécessaires aux tests sont dans tests/FfxiMacros.Tests/Samples/.
/USER/

# Build autonome publie avec :
#   dotnet publish src/FfxiMacros.App -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o publish
publish/

# Notes de publication : elles contiennent la correspondance entre les noms réels et leurs
# substituts, donc elles restent locales — les publier annulerait l'anonymisation.
GITHUB.md

# Brief de départ : document de travail personnel, pas de la documentation du projet.
PROMPT_FFXI_Macro_Editor.md

# Sets exportes depuis l'application : ils portent le nom du personnage et ses macros.
/*-book*-set*.txt
/*-book*-set*.json

# Relevés du scanner de mémoire : adresses et journaux d'une session de jeu précise, sans valeur
# une fois le client relancé.
tools/**/candidates.txt
tools/**/*.log

# Images sources fournies à la main pour fabriquer l'icône ; l'icône elle-même est versionnée.
/ChatGPT Image*.png
/Icone.png

# Captures d'ecran de l'application, prises pour signaler un defaut : elles montrent des
# macros reelles et ne documentent rien une fois le defaut corrige.
/FfxiMacroEditor_*.png
