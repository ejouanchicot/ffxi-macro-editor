<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FfxiMacros.App.App"
             RequestedThemeVariant="Dark">

  <!--
    One palette, defined once. Three surface levels give depth without hard borders everywhere:
    the window sits behind the panels, the panels behind the controls you can act on.
  -->
  <Application.Resources>
    <SolidColorBrush x:Key="Bg"            Color="#0D0F16" />
    <SolidColorBrush x:Key="Surface"       Color="#171B26" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1F2434" />
    <SolidColorBrush x:Key="SurfaceHover"  Color="#2A3145" />
    <SolidColorBrush x:Key="Line"          Color="#262C3D" />
    <SolidColorBrush x:Key="LineStrong"    Color="#39415A" />

    <SolidColorBrush x:Key="Text"          Color="#E9ECF3" />
    <SolidColorBrush x:Key="TextDim"       Color="#9BA5BA" />
    <SolidColorBrush x:Key="TextFaint"     Color="#6E7891" />

    <SolidColorBrush x:Key="Accent"        Color="#5B94F0" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#1A3055" />
    <SolidColorBrush x:Key="AccentText"    Color="#A6C8FF" />

    <SolidColorBrush x:Key="Warn"          Color="#E8B152" />

    <!--
      The banner's own surface. It was so dark that the warm border read as an outline drawn around
      a hole; lifted to where the amber is felt across the whole strip, a question about deleting
      files now looks like one.
    -->
    <LinearGradientBrush x:Key="WarnSoft" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#3B2F17" />
      <GradientStop Offset="1" Color="#2A2211" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarnText"      Color="#D8C49B" />
    <SolidColorBrush x:Key="Danger"        Color="#F2777A" />

    <!-- The window is not a flat sheet: a slow top-to-bottom fade gives the panels something to
         sit on, and keeps the largest area of the app from reading as a void. -->
    <LinearGradientBrush x:Key="BgGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#151A28" />
      <GradientStop Offset="0.55" Color="#0F1219" />
      <GradientStop Offset="1" Color="#0B0D13" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PanelGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#1B2030" />
      <GradientStop Offset="1" Color="#151924" />
    </LinearGradientBrush>

    <!--
      Light falls from above, so every raised thing is lighter at the top and every recessed thing
      is darker there. Three pairs is all it takes: what stands up, what is pressed in, and what is
      the one action you are meant to take.
    -->
    <LinearGradientBrush x:Key="RaisedGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#252C3E" />
      <GradientStop Offset="1" Color="#1A1F2C" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RaisedHoverGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#303950" />
      <GradientStop Offset="1" Color="#232A3B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SlotGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#212838" />
      <GradientStop Offset="1" Color="#171C28" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunkenGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#0E1119" />
      <GradientStop Offset="1" Color="#151A25" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#5F97F3" />
      <GradientStop Offset="1" Color="#3568C9" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentSoftGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#26426F" />
      <GradientStop Offset="1" Color="#1A2C4C" />
    </LinearGradientBrush>

    <!--
      Elevation, in three steps.

      Each one is two shadows and a bevel, which is what separates a drawn rectangle from a thing
      standing on a surface: a tight dark shadow for contact, a wide soft one for the ambient light
      it blocks, a hairline of light along the top edge where the light lands, and a darker line
      inside the bottom edge where it does not. Written once here so that everything raised in this
      window is raised by the same light.
    -->
    <BoxShadows x:Key="RestingElevation">0 1 2 0 #4D000000, 0 4 10 -4 #73000000, inset 0 1 0 0 #1CFFFFFF, inset 0 -1 0 0 #33000000</BoxShadows>
    <BoxShadows x:Key="LiftedElevation">0 2 4 0 #59000000, 0 10 22 -6 #A6000000, inset 0 1 0 0 #38FFFFFF, inset 0 -1 0 0 #33000000</BoxShadows>
    <BoxShadows x:Key="AccentElevation">0 2 4 0 #4D000000, 0 8 22 -6 #995B94F0, inset 0 1 0 0 #4DFFFFFF, inset 0 -1 0 0 #33000000</BoxShadows>
    <BoxShadows x:Key="SunkenElevation">inset 0 2 6 0 #8C000000, inset 0 -1 0 0 #14FFFFFF</BoxShadows>

    <FontFamily x:Key="Mono">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BgGradient}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ============================================================ typography -->

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Section labels and anything the eye should be able to skip. -->
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.counter">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- ============================================================== surfaces -->

    <!--
      A panel sits on the window rather than being painted on it: a shadow underneath, and a hair
      of light along its top edge where it catches the light.
    -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="BoxShadow" Value="0 2 4 0 #4D000000, 0 14 34 -10 #A6000000, inset 0 1 0 0 #1CFFFFFF" />
    </Style>

    <!-- The strip that replaces the system title bar. -->
    <Style Selector="Border.header">
      <Setter Property="Background" Value="{DynamicResource RaisedGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BoxShadow" Value="0 2 10 -2 #66000000, inset 0 1 0 0 #1AFFFFFF" />
    </Style>

    <!-- The app mark, and the key badge on a macro slot: small tinted squares. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.slotBadge">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.slotBadge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- The Ctrl-1 / Alt-0 tag in the corner of a macro slot. -->
    <Style Selector="Border.key">
      <Setter Property="Background" Value="#00000000" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- The line number down the left of the editor. -->
    <Style Selector="Border.lineNumber">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <Style Selector="Border.lineNumber > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A small neutral label, e.g. "objet" beside a phrase. -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Panel headings: small, spaced, quiet. -->
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource RaisedGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #1AFFFFFF" />
    </Style>

    <!-- A notice that needs attention without shouting. -->
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
      <Setter Property="BorderThickness" Value="4,1,1,1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="16,12,16,0" />
      <Setter Property="BoxShadow" Value="0 2 4 0 #4D000000, 0 12 30 -8 #99000000, inset 0 1 0 0 #26FFD9A0" />
    </Style>

    <!--
      Warm ink, but ink you can read: this banner asks a question whose answer deletes files, and
      the previous beige on near-black had it whispering. Aimed at the question itself rather than
      at everything inside the banner — as a descendant rule it was also repainting the labels of
      the very buttons meant to answer it, which is how « Cancel » ended up dimmer than the text.
    -->
    <Style Selector="Border.notice > StackPanel > TextBlock">
      <Setter Property="Foreground" Value="#F6E8C8" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- ================================================== the library rows -->

    <!-- The chip at the head of a book row, tinted by the job the book leads with. -->
    <Style Selector="Border.rowBadge">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinWidth" Value="27" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #26FFFFFF, 0 1 3 -1 #80000000" />
    </Style>

    <Style Selector="Border.rowBadge > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
    </Style>

    <!-- =============================================================== buttons -->

    <!--
      A button is a raised thing: lighter at the top, a hairline of light along its upper edge, and
      a shadow beneath it. Pressing it swaps the two — the light goes inside, the shadow with it —
      which is what makes it feel like it went down rather than merely changing colour.
    -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource RaisedGradient}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource RestingElevation}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedHoverGradient}" />
      <Setter Property="BorderBrush" Value="#3D465F" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SunkenGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="{StaticResource SunkenElevation}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#171B26" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>

    <!-- The one action a row is really about: filled, and lit from within. -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
      <Setter Property="BorderBrush" Value="#7FB0FF" />
      <Setter Property="Foreground" Value="#F2F7FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.accent /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="0 4 14 -4 #B03568C9, inset 0 1 0 0 #4DFFFFFF" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6BA1F6" />
      <Setter Property="BoxShadow" Value="0 6 18 -4 #C04C86E8, inset 0 1 0 0 #66FFFFFF" />
    </Style>

    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E2434" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!--
      Quieter, but still a button. It used to be bare text on the background, which made a row of
      real actions read as a sentence — nothing to aim at, nothing to press.
    -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#1C2130" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button.ghost /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #12FFFFFF" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- ================================================== sets and macro slots -->

    <Style Selector="Button.tab, Button.slot">
      <Setter Property="Background" Value="{DynamicResource SlotGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.tab /template/ ContentPresenter, Button.slot /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource RestingElevation}" />
    </Style>

    <Style Selector="Button.tab, Button.slot">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Button.tab:pointerover, Button.slot:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>

    <Style Selector="Button.tab:pointerover /template/ ContentPresenter, Button.slot:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedHoverGradient}" />
      <Setter Property="BorderBrush" Value="#57648A" />
      <Setter Property="BoxShadow" Value="{StaticResource LiftedElevation}" />
    </Style>

    <!-- Pressed: it goes down, and the light goes inside with it. -->
    <Style Selector="Button.tab:pressed, Button.slot:pressed">
      <Setter Property="RenderTransform" Value="translateY(1px)" />
    </Style>

    <Style Selector="Button.tab:pressed /template/ ContentPresenter, Button.slot:pressed /template/ ContentPresenter">
      <Setter Property="BoxShadow" Value="{StaticResource SunkenElevation}" />
    </Style>

    <Style Selector="Button.tab">
      <Setter Property="Padding" Value="6,6" />
    </Style>

    <Style Selector="Button.slot">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Height" Value="56" />
    </Style>

    <!--
      An empty slot is a hole rather than a tile: sunk into the panel, no light on its top edge,
      so a set with three macros in it reads as three at a glance.
    -->
    <Style Selector="Button.empty /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SunkenGradient}" />
      <Setter Property="BorderBrush" Value="#1B2130" />
      <Setter Property="BoxShadow" Value="{StaticResource SunkenElevation}" />
    </Style>

    <!-- The one you are editing, and the set you are on: lit from within. -->
    <Style Selector="Button.slot.current /template/ ContentPresenter, Button.tab.current /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="0 0 16 -2 #995B94F0, inset 0 1 0 0 #40FFFFFF" />
    </Style>

    <!--
      Being dragged: the slot is left behind as a hollow, because the macro itself is under the
      cursor. Showing it in both places at once would say the wrong thing about what is happening.
    -->
    <Style Selector="Button.slot.dragging">
      <Setter Property="Opacity" Value="0.25" />
    </Style>

    <!-- Where it would land, answered before the button is released. -->
    <Style Selector="Button.slot.dropTarget /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <!-- A book being carried: the row is left as a hollow, exactly as a macro slot is. -->
    <Style Selector="Border.row.card.dragging">
      <Setter Property="Opacity" Value="0.25" />
    </Style>

    <!-- Where it would land, answered before the button is released. -->
    <Style Selector="Border.row.card.dropTarget">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!--
      What travels under the cursor is a picture of the thing itself, so the shadow that lifts it
      off the page is all these have to add. A background of their own would sit behind the rounded
      corners and square them off; padding would inset the picture inside its own outline.
    -->
    <Style Selector="Border.ghostCard, Border.ghostSlot">
      <Setter Property="Opacity" Value="0.95" />
      <Setter Property="BoxShadow" Value="0 12 28 0 #A6000000" />
    </Style>

    <Style Selector="Border.ghostCard">
      <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style Selector="Border.ghostSlot">
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <!-- Set 1: the set players anchor on, framed so its neighbours read at a glance. -->
    <Style Selector="Button.home /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.current /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.current /template/ ContentPresenter TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- The EN / FR pair: small, quiet, and unmistakable about which one is on. -->
    <Style Selector="Button.lang">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- A row in the phrase picker. -->
    <Style Selector="Button.phrase">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style Selector="Button.phrase:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>

    <!-- ================================================================ inputs -->

    <!--
      A field is a hollow, not a tile: the gradient runs dark at the top and the shadow falls inside
      it. Against the raised buttons beside it, that alone says which one you type into.
    -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource SunkenGradient}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="inset 0 2 5 0 #80000000" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
      <Setter Property="Background" Value="{DynamicResource SunkenGradient}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Background" Value="{DynamicResource SunkenGradient}" />
      <Setter Property="BoxShadow" Value="inset 0 2 5 0 #80000000, 0 0 0 3 #335B94F0" />
    </Style>

    <!-- Macro text is code: monospaced, so spaces and columns line up. -->
    <Style Selector="TextBox.field">
      <Setter Property="FontFamily" Value="{DynamicResource Mono}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A field whose text cannot be encoded into its fixed-size slot. -->
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="7,0,0,0" />
    </Style>

    <!-- ================================================================= lists -->

    <!--
      A book row is a card of its own: rounded, inset from the panel's edge, so the list reads as
      forty things rather than one striped block. Selection fills it and lights its left edge.
    -->
    <Style Selector="TreeViewItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="2,1" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <!--
      The selection is drawn by the card itself, so the item behind it stays out of the way. A
      character has no card, and keeps the plain fill.
    -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      The tree's own selection is left unpainted. It follows the keyboard as well as the mouse, and
      a book is « open » because its macros are on screen — not because a row happens to be focused.
    -->
    <Style Selector="TreeViewItem:selected Border.row:not(.card)">
      <Setter Property="Background" Value="#1D2536" />
    </Style>

    <Style Selector="TreeViewItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!--
      Hover belongs to the row under the pointer, and to that row alone.

      A tree hands :pointerover to every ancestor of what the pointer is on, so highlighting the
      item lit the character up as well as the book being pointed at — two rows answering one
      pointer. The row draws its own hover instead: a border no bigger than itself, which cannot be
      true of anything else.
    -->
    <!--
      The pseudo-class sits on the part, not on the item: the theme lights PART_LayoutRoot when the
      pointer is over it, so overriding it through the item never matched anything.
    -->
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      No transition on the background: these are gradients, and a brush transition between two of
      them does not interpolate — it swallows the change instead of easing it.
    -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="5,1" />
    </Style>

    <!-- Only the rows without a card of their own: a card lights itself, and twice reads as a smear. -->
    <Style Selector="Border.row:not(.card):pointerover">
      <Setter Property="Background" Value="#17FFFFFF" />
    </Style>

    <!--
      A book is something you press, so it is drawn as something you can press: a raised card with
      its own edge, lit along the top, sitting on a shadow. Forty names in a column read as a
      paragraph; forty cards read as forty things.
    -->
    <Style Selector="Border.row.card">
      <Setter Property="Background" Value="{DynamicResource SlotGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="BoxShadow" Value="{StaticResource RestingElevation}" />
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Hovering lifts it off the panel rather than merely tinting it. -->
    <Style Selector="Border.row.card:pointerover">
      <Setter Property="Background" Value="{DynamicResource RaisedHoverGradient}" />
      <Setter Property="BorderBrush" Value="#57648A" />
      <Setter Property="BoxShadow" Value="{StaticResource LiftedElevation}" />
      <Setter Property="RenderTransform" Value="translateY(-1px)" />
    </Style>

    <!-- The book being edited, filled and lit, the way the current macro slot is. -->
    <Style Selector="Border.row.card.current">
      <Setter Property="Background" Value="{DynamicResource AccentSoftGradient}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BoxShadow" Value="{StaticResource AccentElevation}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>

    <!-- Slim scrollbars: forty books scroll often, and the bar should not be part of the design. -->
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="9" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="9" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource LineStrong}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource TextFaint}" />
    </Style>

  </Application.Styles>

</Application>
